@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix v2:   <http://example.org/vocab/v2#> .

v2:HumanShape a sh:NodeShape ;
  sh:targetClass v2:Human ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
  sh:property [
    sh:path v2:firstName ; sh:minCount 1 ; sh:datatype xsd:string ; sh:maxCount 1
  ] , [
    sh:path v2:age ; sh:datatype xsd:integer ; sh:maxCount 1
  ] , [
    sh:path v2:status ;
    sh:in ( "active" "retired" )
  ] , [
    sh:path v2:affiliation ; sh:class v2:Organization
  ] , [
    sh:path v2:contactPerson ; sh:class v2:Human
  ] .

v2:OrganizationShape a sh:NodeShape ;
  sh:targetClass v2:Organization ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
  sh:property [
    sh:path v2:status ;
    sh:in ( "active" "retired" )
  ] .

v2:PostalAddressShape a sh:NodeShape ;
  sh:targetClass v2:PostalAddress ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
  sh:property [
    sh:path v2:countryCode ; sh:datatype xsd:string ; sh:minCount 1
  ] .

v2:LocationShape a sh:NodeShape ;
  sh:targetClass v2:Location ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type rdfs:label rdfs:comment ) ;
  sh:property [
    sh:path v2:fullAddress ; sh:minCount 1 ; sh:datatype xsd:string
  ] .
